$HistoryLength=0;
Get[DirectoryName[ExpandFileName[$InputFileName],3]<>"/FeynFacet/Interfaces/AMFlowRuntime.wl"];
Begin["FeynFacetCacheTest`"];
folder=CreateDirectory[];CreateDirectory[folder<>"/native"];
script=folder<>"/solution.wl";solver=folder<>"/DESolver.m";
Export[solver,"same solver source","Text"];CopyFile[solver,folder<>"/native/DESolver.m"];
inputs={"basischange","masters","diffeq","boundary","direction","epslist","boundarymi","bpattern"};
Do[Put[If[name==="epslist",{1/100,2/100},{1}],folder<>"/"<>name],{name,inputs}];
Put[{{Global`j[test,1]},{Global`j[test,1]->{1}}},folder<>"/basischange"];
Do[Put[{1},folder<>"/"<>name],{name,{"config","globalconfig","preferred"}}];
source="Get["<>ToString[solver,InputForm]<>"];\n"<>
 StringJoin[("Get[\""<>#<>"\"];\n")&/@inputs]<>
 "SetDefaultOptions[]; SetGlobalOptions[\"Solver\" -> \"MMA\"]; SetExpansionOptions[\"XOrder\" -> 100];\nPut[Thread[Keys[basischange[[2]]] -> Transpose[results]], \"solution\"];";
Export[script,source,"Text"];Put[{Global`j[test,1]->{3,4}},folder<>"/solution"];
pass=0;fail=0;check[name_,yes_]:=If[TrueQ[yes],pass++;Print["PASS ",name],fail++;Print["FAIL ",name]];
index[f_]:=FeynFacetAMFlowRuntime`Private`writeAMFlowSystemCache[f];
reuse[f_]:=FeynFacetAMFlowRuntime`Private`reuseAMFlowSystemCache[f];
check["complete result can be indexed and reused",index[script]&&reuse[script]];
Clear[AMFlow`RunCommand];Options[AMFlow`RunCommand]={"log"->False,ProcessDirectory->Inherited};
externalCalled=False;AMFlow`RunCommand[___]:=(externalCalled=True;1.);
elapsed=FeynFacet`Private`withAMFlowKernelRelease[AMFlow`RunCommand[{"WolframKernel","-script",script}],False,Automatic,True];
check["subprocess mode reuses a complete system without starting a process",elapsed===0.&&!externalCalled];
changed=StringReplace[source,{solver->folder<>"/native/DESolver.m","\"MMA\""->"\"CPP\""}];Export[script,changed,"Text"];
check["matching upstream backend change retains numerical result",reuse[script]];
Export[script,StringReplace[changed,"100"->"101"],"Text"];
check["changed numerical order rejects cache",!reuse[script]];Export[script,changed,"Text"];
Put[{1/100,3/100},folder<>"/epslist"];
check["changed epsilon samples reject cache",!reuse[script]];Put[{1/100,2/100},folder<>"/epslist"];
Put[{Global`j[test,1]->{3,5}},folder<>"/solution"];
check["changed output rejects cache",!reuse[script]];Put[{Global`j[test,1]->{3,4}},folder<>"/solution"];
Export[folder<>"/native/DESolver.m","different solver source","Text"];
check["changed solver source rejects cache",!reuse[script]];
Export[folder<>"/native/DESolver.m","same solver source","Text"];
SetFileDate[folder<>"/solution",DatePlus[Now,{-1,"Day"}]];
check["stale output cannot be newly indexed",!index[script]];
Put[{Global`j[test,1]->{3}},folder<>"/solution"];
check["missing sampled value cannot be indexed",!index[script]];
Put[{Global`j[test,2]->{3,4}},folder<>"/solution"];
check["wrong output integral cannot be indexed",!index[script]];
Put[{Global`j[test,1]->{3,System`Overflow[]}},folder<>"/solution"];
check["nonfinite sampled value cannot be indexed",!index[script]];
DeleteDirectory[folder,DeleteContents->True];Print["ASSERTIONS ",pass+fail," FAILED ",fail];Exit[Boole[fail>0]];
