$HistoryLength=0;
Get[DirectoryName[ExpandFileName[$InputFileName],3]<>"/FeynFacet/Interfaces/AMFlowRuntime.wl"];
Begin["FeynFacetRuntimeTest`"];
pass=0;failed=0;
check[name_,condition_]:=If[TrueQ[condition],pass++;Print["PASS ",name],failed++;Print["FAIL ",name]];
folder=CreateDirectory[];script=folder<>"/solver.wls";marker=folder<>"/value.wl";
Export[script,"Global`sentinel=77; Global`created=9; Begin[\"DESolver`\"]; newSymbol=13; End[]; Global`f[t_]:=t+8; Attributes[Global`f]={HoldAll}; Options[Global`f]={}; DESolver`Private`memo[1]=44; $MinPrecision=40; SetDirectory[\"/tmp\"]; Put[{Global`sentinel,Global`created,$MaxExtraPrecision},\""<>marker<>"\"]; Quit[0]; Put[\"incorrect\",\""<>marker<>"\"];","Text"];
Global`sentinel=19;beforeDirectory=Directory[];beforePrecision=$MinPrecision;beforeStack=DirectoryStack[];
$MaxExtraPrecision=Infinity;
Global`f[t_]:=t+1;Options[Global`f]={"X"->4};SetAttributes[Global`f,Listable];
DESolver`Private`memo[1]=23;

result=FeynFacet`Private`runIsolatedWolframScript[script,{},folder<>"/log"];
check["generated script completed and Quit stopped evaluation",result["ExitCode"]===0&&Get[marker]==={77,9,50}];
check["caller Global definitions restored",Global`sentinel===19&&System`Names["Global`created"]==={}];
check["temporary solver package definitions removed",System`Names["DESolver`newSymbol"]==={}];
check["directory and precision restored",Directory[]===beforeDirectory&&DirectoryStack[]===beforeStack&&$MinPrecision===beforePrecision&&$MaxExtraPrecision===Infinity];
check["parent function attributes options and solver cache restored",Global`f[2]===3&&Options[Global`f]==={"X"->4}&&Attributes[Global`f]==={Listable}&&DESolver`Private`memo[1]===23];
Export[script,"Global`sentinel=-1; Abort[];","Text"];
result=FeynFacet`Private`runIsolatedWolframScript[script,{},folder<>"/abort.log"];
check["abort is reported and caller state restored",result["ExitCode"]===130&&Global`sentinel===19];
Clear[AMFlow`RunCommand];Options[AMFlow`RunCommand]={"log"->False,ProcessDirectory->Inherited};
AMFlow`RunCommand[___]:=(externalCalled=True;0);
externalCalled=False;
Export[script,"Quit[0];","Text"];
time=FeynFacet`Private`withAMFlowKernelRelease[AMFlow`RunCommand[{"/usr/bin/WolframKernel","-noprompt","-script",script},"log"->folder<>"/inline"],True];
check["inline adapter invokes no external Wolfram process",NumberQ[time]&&!externalCalled];
source=CreateDirectory[folder<>"/AMFlow"];native=CreateDirectory[folder<>"/AMFlowNative"];
CreateDirectory[source<>"/diffeq_solver"];CreateDirectory[native<>"/diffeq_solver"];
Do[Export[path<>"/AMFlow.m","same upstream package","Text"];
 Export[path<>"/diffeq_solver/DESolver.m","same upstream solver","Text"],{path,{source,native}}];
select[spec_]:=FeynFacetAMFlowRuntime`Private`selectAMFlowRuntime[spec];
check["automatic backend retains MMA without native installation",select[<|"AMFlowPath"->source|>]["AMFlowDESolver"]==="MMA"];
Export[native<>"/diffeq_solver/link","test installation marker","Text"];
check["automatic backend uses matching native source",select[<|"AMFlowPath"->source|>]===<|"AMFlowPath"->native,"AMFlowDESolver"->"CPP"|>];
check["explicit MMA remains available",select[<|"AMFlowPath"->source,"AMFlowDESolver"->"MMA"|>]["AMFlowDESolver"]==="MMA"];
Export[native<>"/diffeq_solver/DESolver.m","different upstream version","Text"];
check["incompatible native installation is rejected",select[<|"AMFlowPath"->source|>]["AMFlowDESolver"]==="MMA"&&
 FailureQ[select[<|"AMFlowPath"->source,"AMFlowDESolver"->"CPP"|>]]];
DeleteDirectory[folder,DeleteContents->True];
Print["ASSERTIONS ",pass+failed," FAILED ",failed];Exit[Boole[failed>0]];
