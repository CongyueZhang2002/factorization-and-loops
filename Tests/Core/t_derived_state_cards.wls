Print["FEYNFACET DRIVER ENTERED"];$HistoryLength=0;
root=DirectoryName[ExpandFileName[$InputFileName],3];Get[root<>"/Tests/TestKit.wl"];
Block[{Print},Get[root<>"/Addon/Load/LoadFACET.wl"]];$PrePrint=.;
cards=Select[FileNames["*.wl",root<>"/Projects",Infinity],MemberQ[{"Common-Card.wl","Card.wl","Result_Card.wl"},FileNameTake[#]]&&FreeQ[FileNameSplit[#],"Work"|"Exports"]&];
invalid=Select[cards,!AssociationQ[Quiet[Check[Get[#],$Failed]]]&];
If[invalid=!={},Print["INVALID AUTHORED CARDS: ",InputForm[invalid]]];
FTTest`FTAssert["all authored cards remain valid Wolfram associations",invalid==={}];
projects=FileNames["Common-Card.wl",root<>"/Projects",Infinity];
results=FeynFacet`ReadProjectCard[DirectoryName[#]]&/@projects;
FTTest`FTAssert["all project declarations compile without independent state factors",AllTrue[results,AssociationQ]];
read[project_,order_,channel_,name_]:=FeynFacet`ReadContributionCard[root<>"/Projects/"<>project<>"/Raw/"<>order<>"/"<>channel,name];
hi=read["SIDIS_HighPT_TT_SpinTransfer","NLO","q-q","Real"];
parts=FeynFacet`Private`projectContributionComponents[hi];
FTTest`FTAssert["fixed-tag real gg factor is derived",parts["Real.Gluons"]["SymmetryFactor"]===1/2];
FTTest`FTAssert["fixed-tag different up flavors counted",parts["Real.DifferentFlavorUp"]["FlavorMultiplicity"]===nU-1];
FTTest`FTAssert["fixed-tag different down flavors counted",parts["Real.DifferentFlavorDown"]["FlavorMultiplicity"]===nD];
sq=read["SIDIS_UU","NNLO","q-qb","DoubleReal.IdenticalQuarks"];
FTTest`FTAssert["NNLO identical recoil pair factor is derived",sq["SymmetryFactor"]===1/2];
gg=FeynFacet`Private`projectContributionComponents[read["SIDIS_UU","NNLO","g-g","DoubleReal"]];
FTTest`FTAssert["NNLO all up/down pair counts are derived",gg["DoubleReal.UpTypePair"]["FlavorMultiplicity"]===nU&&gg["DoubleReal.DownTypePair"]["FlavorMultiplicity"]===nD];
pq=FeynFacet`Private`projectContributionComponents[read["ppHX_UU","NLO","qg-qg","Real"]];
FTTest`FTAssert["pure QCD flavor count includes both charge classes",Expand[pq["Real.State02"]["FlavorMultiplicity"]-(nU+nD-1)]===0];
FTTest`FTAssert["QCD identical gluon factor derived independently of flavor",pq["Real.State03"]["SymmetryFactor"]===1/2];
eec=read["EE_EEC","NLO","q-qb","Real"];
FTTest`FTAssert["fully integrated EEC has no extra pair-count multiplier",eec["SymmetryFactor"]===1&&eec["FlavorMultiplicity"]===1];
bad=Catch[FeynFacet`Private`projectCheckStateDeclarations[<|"SymmetryFactor"->2|>],"ProjectCards"];
FTTest`FTAssert["handwritten wrong state factor is rejected",FailureQ[bad]];
request=FeynFacet`ProjectAssemblyRequest[parts["Real.Gluons"]];
FTTest`FTAssert["current assembly receives derived state factor",AssociationQ[request]&&request["SymmetryFactor"]===1/2];
ordinary=Select[cards,FileNameTake[#]==="Card.wl"&&Get[#]["Contribution"]=!="Counterterm"&];
compiled=FeynFacet`ReadContributionCard[DirectoryName[#,2],FileNameTake[DirectoryName[#]]]&/@ordinary;
FTTest`FTAssert["every ordinary contribution compiles its external-state sum",AllTrue[compiled,AssociationQ]];
If[!AllTrue[compiled,AssociationQ],Print["FAILED STATE SUMS ",InputForm[Pick[ordinary,FailureQ/@compiled]]]];
alias=Join[hi["SpeciesMap"],<|{"q","alias"}->hi["SpeciesMap"][{"q","u"}],{"qb","alias"}->hi["SpeciesMap"][{"qb","u"}]|>];
FTTest`FTAssert["two labels cannot count the same physical model flavor twice",FailureQ[
 FeynFacet`Private`modelFlavorEquivalenceClasses[hi["ProcessDefaults"],alias]]];
Print["DERIVED STATE CARDS COMPLETED"];FTTest`FTReport[];
