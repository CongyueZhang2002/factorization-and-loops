Print["FEYNFACET DRIVER ENTERED"];
$HistoryLength=0;$MaxExtraPrecision=50;
root=DirectoryName[ExpandFileName[$InputFileName],3];Get[root<>"/Tests/TestKit.wl"];
Block[{Print},Get[root<>"/Addon/Load/LoadFACET.wl"]];$PrePrint=.;
card=FeynFacet`ReadContributionCard[root<>"/Projects/EE_EEC/Raw/LO/q-qb","Born"];
FTTest`FTAssert["timelike current with no factorization legs compiles from a common card",AssociationQ[card]];
If[!AssociationQ[card],Print[InputForm[card]];FTTest`FTReport[]];
setup=FeynFacet`ReadProcessCard[card];
FTTest`FTAssert["all final-state partons are integrated and spin summed",AssociationQ[setup]&&setup["SpinDensities"]==={}];
If[!AssociationQ[setup],Print[InputForm[setup]];FTTest`FTReport[]];
request=FeynFacet`ProjectAssemblyRequest[card];
source=FeynFacet`ConstructCurrentIntegrands[setup,Join[request,<|"PrintTimings"->True|>]];
FTTest`FTAssert["the inclusive Born current is generated by the existing amplitude algebra",AssociationQ[source]];
If[!AssociationQ[source],Print[InputForm[source]];FTTest`FTReport[]];
kin=FeynCalc`FCI[{FeynCalc`SPD[k1,q]->Q2/2,FeynCalc`SPD[k2,q]->Q2/2,
 FeynCalc`SPD[k1,k2]->Q2/2,FeynCalc`SPD[q]->Q2}];
FTTest`FTAssert["the generated spin/color sum equals the independent Born trace",
 Factor[(source["Values"]["Scalar"]/.kin)-2(D-2)FeynCalc`CA Q2]===0];
FeynFacet`FamilyArtifactWrite[source,card["WorkDirectory"]<>"/Integrands.wl"];
Print["INCLUSIVE CURRENT TEST COMPLETE"];
FTTest`FTReport[];
