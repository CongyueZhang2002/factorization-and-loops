#!/usr/bin/env wolframscript
(* Exact verification of the realization transfers for boundary periods
   1, 6 and 7.

   The three periods are 3-particle massless cut phase-space integrals of
   the same total momentum P = ka + kb - kc, carrying exactly one uncut
   denominator.  The cut measure dPhi3(P; q1,q2,q3) is symmetric in the
   three cut momenta, so such an integral is completely determined by the
   invariant form of its uncut denominator in terms of the cut momenta:

     PID 6/7 signature :  D = (ka + kb - q)^2  for some cut momentum q
     PID 1   signature :  D = (kc - ka + q)^2  for some cut momentum q

   A transfer to another realization is therefore EXACT if, in the target
   family, the period row's master has index 1 on precisely the three cut
   propagators and on exactly one uncut propagator, and that uncut
   propagator reduces on the cut to the same invariant form.  The explicit
   change of variables is then the permutation identifying the target's
   cut momenta with the source's.

   Everything below is symbolic: propagators are reduced modulo the ideal
   generated by the cut conditions, over exact rational kinematics
     ka^2 = kb^2 = kc^2 = 0, 2 ka.kb = 1, 2 ka.kc = v, 2 kb.kc = w.

   Acceptance: the printed table, and TRANSFERS_CHECKED = <count>.
*)

root = ExpandFileName[FileNameJoin[{DirectoryName[$InputFileName],
   "..", "..", "..", "..", ".."}]];
bp = FileNameJoin[{DirectoryName[$InputFileName], ".."}];

famData = Get[FileNameJoin[{bp, "Certificates", "FamilyCutData.wl"}]];
nullity = Get[FileNameJoin[{bp, "Certificates", "NullityPeriods.wl"}]];

deOf[fam_] := deOf[fam] = Get[FileNameJoin[{root, "ppHX_NNLO_DoubleReal",
    "Results", "UU_08_10_canonical", "DifferentialEquations",
    "nnlo_de_" <> fam <> ".wl"}]];

(* ---------- exact scalar-product algebra ---------- *)

momBasis = {"ka", "kb", "kc", "ke", "kf"};
vecOf[assoc_] := Lookup[assoc, momBasis, 0];

(* Gram matrix: external kinematics fixed, loop entries symbolic. *)
gsym[i_, j_] := gsym[i, j] = Symbol["gg" <> ToString[Min[i, j]] <> ToString[Max[i, j]]];
gram = Table[
   Which[
    i <= 3 && j <= 3,
     Which[i === j, 0,
      Sort[{i, j}] === {1, 2}, 1/2,
      Sort[{i, j}] === {1, 3}, v/2,
      Sort[{i, j}] === {2, 3}, w/2],
    True, gsym[i, j]],
   {i, 5}, {j, 5}];

dotp[p_, q_] := Expand[p . gram . q];
sqp[p_] := dotp[p, p];

(* ---------- per-family reduction on the cut ---------- *)

cutRuleOf[fam_] := cutRuleOf[fam] = Module[
   {d = famData[fam], props, cuts, cutMom, eqs, unk, sol},
   props = d["Propagators"];
   cuts = d["CutPropagators"];
   cutMom = vecOf[props[[#]]["Momentum"]] & /@ cuts;
   eqs = Thread[(sqp /@ cutMom) == 0];
   unk = {gsym[4, 4], gsym[5, 5], gsym[4, 5]};
   sol = Solve[eqs, unk];
   If[sol === {} || Length[sol] =!= 1,
     Print["[WARN] cut conditions did not solve uniquely for ", fam];
     {}, First[sol]]];

reduceOnCut[fam_, expr_] := Together[Expand[expr /. cutRuleOf[fam]]];

cutMomentaOf[fam_] := Module[{d = famData[fam]},
   vecOf[d["Propagators"][[#]]["Momentum"]] & /@ d["CutPropagators"]];

(* Invariant signatures, built from the target family's own cut momenta. *)
kaV = vecOf[<|"ka" -> 1|>]; kbV = vecOf[<|"kb" -> 1|>];
kcV = vecOf[<|"kc" -> 1|>];

sig67[fam_] := reduceOnCut[fam, sqp[kaV + kbV - #]] & /@ cutMomentaOf[fam];
sig1[fam_] := reduceOnCut[fam, sqp[kcV - kaV + #]] & /@ cutMomentaOf[fam];

(* ---------- locate the period master in a family ----------

   NOTE.  The family -> row pairing cannot be read off NullityPeriods.wl:
   dedup.wls builds

       "Families"  -> DeleteDuplicates[#["Family"] & /@ g],
       "BlockRows" -> DeleteDuplicates[#["Rows"]   & /@ g]

   i.e. it deduplicates the two lists INDEPENDENTLY, so they are not
   positionally aligned (PID 6 has 9 families but only 6 distinct row
   lists).  The pairing is not recoverable from that record.

   This test therefore does not use BlockRows at all.  It SEARCHES each
   target family's block basis for a master with the period's shape, and
   then checks the invariant signature.  That is both independent of the
   damaged pairing and a stronger statement: it decides whether the family
   contains a realization of the period at all.                          *)

rowShape[fam_, row_] := Module[
   {de = deOf[fam], basis, master, idx, d = famData[fam], onProps, cuts,
    cutOn, uncutOn},
   basis = de["BlockBasis"];
   master = basis[[row]];
   idx = master[[2]];
   cuts = d["CutPropagators"];
   onProps = Flatten[Position[idx, x_ /; x > 0, {1}, Heads -> False]];
   cutOn = Intersection[onProps, cuts];
   uncutOn = Complement[onProps, cuts];
   <|"Row" -> row, "Master" -> master, "Indices" -> idx,
     "CutOn" -> cutOn, "UncutOn" -> uncutOn, "BlockLength" -> Length[basis],
     "AllCutsOn" -> (Sort[cutOn] === Sort[cuts]),
     "SingleUncut" -> (Length[uncutOn] === 1 &&
        idx[[First[uncutOn]]] === 1)|>];

(* every master in the family block that has the one-uncut-denominator
   cut shape *)
candidateRows[fam_] := Select[
   rowShape[fam, #] & /@ Range[Length[deOf[fam]["BlockBasis"]]],
   #["AllCutsOn"] && #["SingleUncut"] &];

(* the volume master: index 1 on exactly the three cut propagators *)
volumeRows[fam_] := Select[Range[Length[deOf[fam]["BlockBasis"]]],
   Module[{ix = deOf[fam]["BlockBasis"][[#]][[2]]},
     Flatten[Position[ix, x_ /; x > 0, {1}, Heads -> False]] ===
       Sort[famData[fam]["CutPropagators"]] &&
     Max[ix] === 1] &];

(* ---------- the transfer table ---------- *)

periods = nullity["Periods"];
pidRec[pid_] := SelectFirst[periods, #["PeriodID"] === pid &];

transfers = Flatten[Table[
   Module[{rec = pidRec[pid]},
    Table[<|"PID" -> pid, "Family" -> f|>, {f, rec["Families"]}]],
   {pid, {1, 6, 7}}], 1];

Print["Transfers to check: ", Length[transfers]];
Do[Module[{rec = pidRec[pid]},
   Print["  PID ", pid, ": ", Length[rec["Families"]], " families, ",
     Length[rec["BlockRows"]], " distinct BlockRows entries",
     If[Length[rec["Families"]] =!= Length[rec["BlockRows"]],
       "  <-- pairing not recoverable (independent DeleteDuplicates)", ""]]],
 {pid, {1, 6, 7}}];
Print[""];

sourceOf = <|1 -> "CF1", 6 -> "CF124", 7 -> "CF124"|>;
sigNameOf = <|1 -> "(kc-ka+q)^2", 6 -> "(ka+kb-q)^2", 7 -> "(ka+kb-q)^2"|>;

(* Control: the source families must exhibit their own signature. *)
Print["--- control: source families ---"];
Do[Module[{fam = sourceOf[pid], row, rd, dun, sig, hit},
   row = If[pid === 1, 2, 6];
   rd = rowShape[fam, row];
   dun = reduceOnCut[fam,
     sqp[vecOf[famData[fam]["Propagators"][[First[rd["UncutOn"]]]]["Momentum"]]]];
   sig = If[pid === 1, sig1[fam], sig67[fam]];
   hit = Flatten[Position[Together[sig - dun], 0, {1}, Heads -> False]];
   Print["  PID ", pid, " source ", fam, " row ", row, ": uncut #",
     First[rd["UncutOn"]], " = ", InputForm[dun],
     "  matches ", sigNameOf[pid], " at cut leg ", hit,
     "  volume rows ", volumeRows[fam]]],
 {pid, {1, 6, 7}}];

Print[""];
Print["--- transfers ---"];
results = Table[
   Module[{pid = tr["PID"], fam = tr["Family"], cands, sig, matches,
     status, volRow, hits},
    If[! KeyExistsQ[famData, fam],
     Print["  PID ", pid, " -> ", fam, ": NO FAMILY DATA"];
     Return[<|"PID" -> pid, "Family" -> fam, "Status" -> "NoData"|>, Module]];
    cands = candidateRows[fam];
    volRow = volumeRows[fam];
    sig = If[pid === 1, sig1[fam], sig67[fam]];
    (* keep every candidate whose uncut denominator matches the signature *)
    hits = Select[
      Table[Module[{rd = c, dun, hit, avRow, nz},
        dun = reduceOnCut[fam,
          sqp[vecOf[famData[fam]["Propagators"][[
            First[rd["UncutOn"]]]]["Momentum"]]]];
        hit = Flatten[Position[Together[sig - dun], 0, {1}, Heads -> False]];
        avRow = Simplify /@ deOf[fam]["Av"][[rd["Row"]]];
        nz = Flatten[Position[avRow, x_ /; x =!= 0, {1}, Heads -> False]];
        <|"Row" -> rd["Row"], "Master" -> rd["Master"], "Duncut" -> dun,
          "CutLeg" -> hit, "AvCouplings" -> nz,
          "CouplesOnlyToVolume" ->
            (Complement[nz, Join[volRow, {rd["Row"]}]] === {})|>],
       {c, cands}],
      #["CutLeg"] =!= {} &];
    status = Which[
      hits === {} && cands === {}, "NoOneUncutMaster",
      hits === {}, "SignatureMismatch",
      True, "Exact"];
    Print["  PID ", pid, " -> ", fam, ": ", status,
      "   (", Length[cands], " one-uncut candidate rows, ",
      Length[hits], " signature matches, volume rows ", volRow, ")"];
    Do[Print["      row ", h["Row"], "  ", InputForm[h["Master"]],
       "   D_uncut = ", InputForm[h["Duncut"]],
       "   cut leg ", h["CutLeg"],
       "   Av couplings ", h["AvCouplings"],
       If[h["CouplesOnlyToVolume"], " (volume only)", " (EXTRA COUPLINGS)"]],
     {h, hits}];
    If[hits === {} && cands =!= {},
      Do[Print["      candidate row ", c["Row"], " ",
         InputForm[c["Master"]], " uncut #", c["UncutOn"], " does not match"],
       {c, cands}]];
    <|"PID" -> pid, "Family" -> fam, "Status" -> status,
      "Candidates" -> Length[cands], "VolumeRows" -> volRow,
      "Matches" -> hits|>],
   {tr, transfers}];

(* ---------- normalization conventions ----------
   The recorded period value is an exact ZERO, and a zero is invariant
   under any nonzero normalization factor, so the transfer of THIS period
   does not depend on the cross-family normalization.  A nonzero period
   would additionally need the constant.  We still record the convention
   strings, since they are what a future nonzero transfer must match. *)

Print[""];
Print["--- normalization conventions (modulo the cut list) ---"];
convOf[fam_] := StringReplace[deOf[fam]["Convention"],
   RegularExpression["cuts \\{[^}]*\\}"] -> "cuts {...}"];
allFams = DeleteDuplicates[Join[{"CF1", "CF124"}, #["Family"] & /@ results]];
convs = AssociationMap[convOf, allFams];
Print["  distinct conventions: ", Length[DeleteDuplicates[Values[convs]]]];
Do[Print["    ", c], {c, DeleteDuplicates[Values[convs]]}];
report0 = Length[DeleteDuplicates[Values[convs]]] === 1;
Print["  CONVENTIONS_UNIFORM = ", report0];

Print[""];
Print["Summary: ",
  Counts[#["Status"] & /@ results]];
Print["TRANSFERS_CHECKED = ", Length[results]];
Print["TRANSFERS_EXACT = ", Count[results, r_ /; r["Status"] === "Exact"]];

Export[FileNameJoin[{bp, "Certificates", "TransferResults.wl"}], results];
Print["wrote Certificates/TransferResults.wl"];
