Options[EvaluateMasterIntegralSolution]={
 "NumericalBackend"->Automatic,"Threads"->1,
 "QuadratureOrder"->16,"WorkingPrecision"->Automatic,
 "AccuracyGoal"->20,"PrecisionGoal"->20,"InputGuardDigits"->5,"CheckConvergence"->True,
 "InitialConstantValues"->Automatic,"IntegrationBreakpoints"->{0,1},
 "BoundaryWorkingPrecision"->Automatic,"MaxBoundaryWorkingPrecision"->600,
 "MaxQuadratureOrder"->128,"MaxRefinements"->6,"MaxWorkingPrecision"->300,
 "PathCheck"->Automatic,"PathCheckTimeLimit"->5,"TimeLimit"->300};
(* Accuracy is controlled by the explicit precision/refinement options below.
   An inherited unlimited extra-precision setting can make N chase relative
   digits of an exactly vanishing boundary combination indefinitely. *)
EvaluateMasterIntegralSolution[data_Association,point_List,opts:OptionsPattern[]] := Block[{$MinPrecision=0,$MaxPrecision=Infinity,$MaxExtraPrecision=50},Module[
 {initial=OptionValue["QuadratureOrder"],wp=OptionValue["WorkingPrecision"],
  ag=OptionValue["AccuracyGoal"],pg=OptionValue["PrecisionGoal"],guard=OptionValue["InputGuardDigits"],
  maxOrder=OptionValue["MaxQuadratureOrder"],limit=OptionValue["MaxRefinements"],
  maxPrecision=OptionValue["MaxWorkingPrecision"],breaks=OptionValue["IntegrationBreakpoints"],
  input=OptionValue["InitialConstantValues"],converge=OptionValue["CheckConvergence"],
  pathCheck=OptionValue["PathCheck"],pathSeconds=OptionValue["PathCheckTimeLimit"],
  timeLimit=OptionValue["TimeLimit"],history={},rules,supplied,report,low,high,mesh,precise,
  lv,hv,mv,pv,n,next,refined,resolution,meshError,precisionError,roundoff,ratio,
  inputPrecision,inputUncertainty,inputs,attempt,elapsed=AbsoluteTime[],result,run,
  prepared,backend=OptionValue["NumericalBackend"],threads=OptionValue["Threads"],
  evaluationCount=0,reuseCount=0,cache=<||>,evaluateCached,key,cached,diagnostics},
 If[AssociationQ[Lookup[data,"SingularBoundaryNumericalInput",None]],
  Return[evaluateMasterFromSingularBoundary[data,point,
    Join[Association[Options[FeynFacetSolution`EvaluateMasterIntegralSolution]],Association[{opts}]]]]];
 If[backend==="GiNaC",
  Return[evaluateGPLMaster[data,point,<|
   "WorkingPrecision"->wp,"AccuracyGoal"->ag,"PrecisionGoal"->pg,
   "InputGuardDigits"->guard,"InitialConstantValues"->input,
   "MaxWorkingPrecision"->maxPrecision,"CheckConvergence"->converge,
   "TimeLimit"->timeLimit,"PathCheckTimeLimit"->pathSeconds|>]]];
 result=TimeConstrained[Catch[
  If[!IntegerQ[initial]||initial<2||!IntegerQ[ag]||ag<1||!IntegerQ[pg]||pg<1||
    !IntegerQ[guard]||guard<0||!IntegerQ[maxOrder]||maxOrder<initial||!IntegerQ[limit]||limit<1||
    !IntegerQ[maxPrecision]||maxPrecision<20||!MemberQ[{True,False},converge],
   numericalFailure["InvalidNumericalParameters"]];
  If[wp===Automatic,wp=Max[50,ag+25,pg+25]];
  If[!IntegerQ[wp]||wp<Max[ag,pg]+10||maxPrecision<wp,
   numericalFailure["InsufficientWorkingPrecision"]];
  If[Length[point]=!=Length[data["KinematicVariables"]]||!VectorQ[point,finiteNumericQ],
   numericalFailure["NumericKinematicPointRequired"]];
  If[!VectorQ[breaks,NumericQ]||Length[breaks]<2||First[breaks]!=0||Last[breaks]!=1||
    !And@@Thread[Differences[breaks]>0],numericalFailure["InvalidIntegrationBreakpoints"]];
  rules=constantRules[data,input];supplied=input=!=Automatic;
  If[supplied&&!AssociationQ[Lookup[data,"MasterIntegralCoefficients",None]],
   numericalFailure["StoredMasterIntegralCoefficientsRequired"]];
  inputs=Cases[{point,Last/@rules,breaks,Lookup[data,"KernelDefinitions",{}],
    data["IntegralDefinitions"],data["AlgebraicDefinitions"],
    Lookup[data,"MasterIntegralCoefficients",<||>]},_Real|_Complex,Infinity];
  inputPrecision=If[inputs==={},Infinity,Min[Precision/@inputs]/.MachinePrecision->$MachinePrecision];
  inputUncertainty=If[inputs==={},0,roundoffRatio[inputs,ag+guard,pg+guard]];
  If[!TrueQ[inputUncertainty<=1],
   numericalFailure["NumericalInputPrecisionInsufficient",
    <|"AvailablePrecision"->inputPrecision,"InputUncertaintyRatio"->inputUncertainty,
      "RequiredGuardDigits"->guard|>]];
  report=If[pathCheck===None,<|"Method"->"NotRequested","FullAnalyticContinuationVerified"->False|>,
    polynomialPathCheck[data,point,pathSeconds]];
  prepared=prepareFiniteNumerics[data,backend,threads];
  diagnostics[] := <|"NumericalBackend"->prepared["NumericalPreparation"]["Backend"],
    "NumericalEvaluationCount"->evaluationCount,"ReusedEvaluationCount"->reuseCount,
    "Threads"->threads,
    "NumericalBackendFallbackReason"->Lookup[prepared["NumericalPreparation"],"FallbackReason",None]|>;
  evaluateCached[order_,digits_,partition_] := Module[{cacheKey={order,digits,partition},value},
   If[KeyExistsQ[cache,cacheKey],reuseCount++;Return[cache[cacheKey]]];
   evaluationCount++;
   value=applyConstants[evaluateFinitePanels[prepared,point,order,digits,partition],rules];
   AssociateTo[cache,cacheKey->value];value];
  n=initial;
  Do[
   low=evaluateCached[n,wp,breaks];
   If[!converge,Return[Join[low,diagnostics[],<|"Status"->"EvaluatedWithoutConvergenceCheck",
     "PathCheck"->report,"ErrorEstimateIsRigorousBound"->False|>],Module]];
   lv=comparisonVector[data,low,supplied];
   next=Min[maxOrder,Ceiling[3 n/2]];
   If[next==n,breaks=Sort[Join[breaks,Mean/@Partition[breaks,2,1]]];n=initial;Continue[]];
   high=evaluateCached[next,wp,breaks];
   hv=comparisonVector[data,high,supplied];
   resolution=scaledDifference[lv,hv,ag,pg];
   roundoff=roundoffRatio[hv,ag,pg];meshError=Infinity;precisionError=Infinity;
   If[resolution<=1&&roundoff<=1,
    refined=Sort[Join[breaks,Mean/@Partition[breaks,2,1]]];
    mesh=evaluateCached[next,wp,refined];
    mv=comparisonVector[data,mesh,supplied];meshError=scaledDifference[hv,mv,ag,pg];
    If[meshError<=1&&wp+20<=maxPrecision,
     precise=evaluateCached[next,wp+20,refined];
     pv=comparisonVector[data,precise,supplied];
     precisionError=scaledDifference[mv,pv,ag,pg];roundoff=roundoffRatio[pv,ag,pg];
     ratio=Max[resolution,meshError,precisionError,roundoff];
     If[ratio<=1,
      AppendTo[history,<|"QuadratureOrders"->{n,next},"Panels"->Length[breaks]-1,
       "WorkingPrecisions"->{wp,wp+20},"OrderDifferenceRatio"->resolution,
       "SubdivisionDifferenceRatio"->meshError,"PrecisionDifferenceRatio"->precisionError,
       "ArithmeticErrorRatio"->roundoff|>];
      Return[Join[precise,diagnostics[],<|"Status"->"NumericalConvergenceObserved",
       "AccuracyGoal"->ag,"PrecisionGoal"->pg,"ConvergenceHistory"->history,
       "ErrorEstimateIsRigorousBound"->False,"PathCheck"->report,
       "ConvergenceQuantity"->If[supplied,"MasterCoefficientsAfterBoundarySubstitution",
        "EvolutionAndBoundaryConstantCoefficients"],
       "ElapsedSeconds"->AbsoluteTime[]-elapsed|>],Module]]]];
   AppendTo[history,<|"QuadratureOrders"->{n,next},"Panels"->Length[breaks]-1,
    "WorkingPrecision"->wp,"OrderDifferenceRatio"->resolution,
    "SubdivisionDifferenceRatio"->meshError,"PrecisionDifferenceRatio"->precisionError,
    "ArithmeticErrorRatio"->roundoff|>];
   If[roundoff>1,
    If[wp+30>maxPrecision,numericalFailure["NumericalWorkingPrecisionLimit",<|"History"->history|>]];
    wp+=30,
    If[meshError>1&&meshError=!=Infinity,breaks=refined];
    n=next],
  {attempt,limit}];
  numericalFailure["NumericalConvergenceNotReached",<|"History"->history,
    "AccuracyGoal"->ag,"PrecisionGoal"->pg|>],
 "NumericalSolution"],timeLimit,
  Failure["NumericalEvaluationTimeLimit",<|"History"->history,"TimeLimit"->timeLimit|>]];
 result
]];
