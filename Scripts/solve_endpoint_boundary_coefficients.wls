Print["FEYNFACET DRIVER ENTERED"];
$HistoryLength=0;$MaxExtraPrecision=50;
root=DirectoryName[ExpandFileName[$InputFileName],2];
Block[{Print},Get[root<>"/Addon/Load/LoadFACET.wl"]];Get[root<>"/FeynFacet/Solution.m"];$PrePrint=.;
args=Rest[$ScriptCommandLine];
If[Length[args]=!=3,Print["Usage: solve_endpoint_boundary_coefficients.wls COEFFICIENT_JETS REQUEST OUTPUT_DIRECTORY"];Exit[2]];
jets=FeynFacet`FamilyArtifactRead[ExpandFileName[args[[1]]]];
request=FeynFacet`FamilyArtifactRead[ExpandFileName[args[[2]]]];out=ExpandFileName[args[[3]]];
If[!DirectoryQ[out],CreateDirectory[out,CreateIntermediateDirectories->True]];
request=Join[request,<|"ProgressFunction"->Function[stage,Print["ENDPOINT ",stage]]|>];
{seconds,result}=AbsoluteTiming[FeynFacet`SolvePhysicalEndpointCoefficientJets[jets,request]];
FeynFacet`FamilyArtifactWrite[result,out<>"/PhysicalEdgeCoefficients.wl",Compression->Automatic];
If[!AssociationQ[result],Print[result];Exit[1]];
Print["COMPLETED EXPLICIT PHYSICAL EDGE COEFFICIENTS ",out," SECONDS ",seconds];
