        RowBox[{"DiagramsBySide", "[", "\"\<Amplitude\>\"", "]"}], ",", 
        RowBox[{"ColumnsXRows", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"5", ",", "2"}], "}"}]}], ",", 
        RowBox[{"Numbering", "\[Rule]", "Simple"}], ",", 
        RowBox[{"SheetHeader", "\[Rule]", "None"}], ",", 
        RowBox[{"DisplayFunction", "\[Rule]", "Identity"}]}], "]"}], ",", 
      RowBox[{"ImageSize", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"1400", ",", "560"}], "}"}]}]}], "]"}]}], "]"}], 
