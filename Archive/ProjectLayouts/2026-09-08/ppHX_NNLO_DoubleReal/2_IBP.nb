Cell[CellGroupData[{

Cell["Load Results", "Section",ExpressionUUID->"2b903b27-38a7-4e89-8866-26d22f9d5ee4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ResultDirectory", " ", "=", " ", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
      "FACETRoot", ",", " ", "\"\<ppHX_NLO\>\"", ",", " ", "\"\<Results\>\"", 
       ",", " ", "\"\<UU_08_04_1\>\""}], "}"}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"PairResults", " ", "=", " ", 
   RowBox[{"Catch", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "card", ",", " ", "forwardIndices", ",", " ", "conjugateIndices", ",",
          " ", "expectedPairs", ",", " ", "pairDirectory", ",", " ", 
         "pairFiles", ",", " ", "pairData", ",", " ", "results", ",", " ", 
         "parsePairFile", ",", " ", "fail"}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"fail", "[", "message_", "]"}], " ", ":=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Print", "[", "message", "]"}], ";", " ", 
           RowBox[{"Throw", "[", 
            RowBox[{"$Failed", ",", " ", "\"\<LoadResults\>\""}], "]"}]}], 
          ")"}]}], ";", "\n", "    ", 
        RowBox[{"card", " ", "=", " ", 
         RowBox[{"Get", "[", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
            "FACETRoot", ",", " ", "\"\<ppHX_NLO\>\"", ",", 
             " ", "\"\<Cards\>\"", ",", " ", 
             RowBox[{"CardName", " ", "<>", " ", "\"\<.wl\>\""}]}], "}"}], 
           "]"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"forwardIndices", " ", "=", " ", 
         RowBox[{
          RowBox[{"card", "[", "\"\<ForwardAmplitudes\>\"", "]"}], 
          "[", "\"\<DiagramIndices\>\"", "]"}]}], ";", "\n", "    ", 
        RowBox[{"conjugateIndices", " ", "=", " ", 
         RowBox[{
          RowBox[{"card", "[", "\"\<ConjugateAmplitudes\>\"", "]"}], 
          "[", "\"\<DiagramIndices\>\"", "]"}]}], ";", "\n", "    ", 
        RowBox[{"expectedPairs", " ", "=", " ", 
         RowBox[{"Sort", " ", "@", " ", 
          RowBox[{"Tuples", "[", 
           RowBox[{"{", 
            RowBox[{"forwardIndices", ",", " ", "conjugateIndices"}], "}"}], 
           "]"}]}]}], ";", "\n", "    ", 
        RowBox[{
         RowBox[{"parsePairFile", "[", "file_", "]"}], " ", ":=", " ", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", "match", "}"}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{"match", " ", "=", " ", 
             RowBox[{"StringCases", "[", "\n", "        ", 
              RowBox[{
               RowBox[{"FileBaseName", "[", "file", "]"}], ",", "\n", 
               "        ", 
               RowBox[{
                RowBox[{
                "StartOfString", " ", "~~", " ", "\"\<F\>\"", " ", "~~", " ", 
                 
                 RowBox[{"forward", " ", ":", " ", 
                  RowBox[{"DigitCharacter", " ", ".."}]}], " ", "~~", "\n", 
                 "          ", "\"\<_C\>\"", " ", "~~", " ", 
                 RowBox[{"conjugate", " ", ":", " ", 
                  RowBox[{"DigitCharacter", " ", ".."}]}], " ", "~~", " ", 
                 "EndOfString"}], " ", ":>", "\n", "          ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"FromDigits", "[", "forward", "]"}], ",", " ", 
                  RowBox[{"FromDigits", "[", "conjugate", "]"}]}], "}"}]}]}], 
              "\n", "      ", "]"}]}], ";", "\n", "      ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "match", "]"}], " ", "===", " ", "1"}], 
              ",", " ", 
              RowBox[{"First", "[", "match", "]"}], ",", " ", "$Failed"}], 
             "]"}]}]}], "\n", "    ", "]"}]}], ";", "\n", "    ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", " ", 
           RowBox[{"DirectoryQ", "[", "ResultDirectory", "]"}]}], ",", " ", 
          RowBox[{"fail", "[", 
           
           RowBox[{"\"\<Result folder not found: \>\"", " ", "<>", " ", 
            "ResultDirectory"}], "]"}]}], "]"}], ";", "\n", "    ", 
        RowBox[{"pairDirectory", " ", "=", " ", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"ResultDirectory", ",", " ", "\"\<Pairs\>\""}], "}"}], 
          "]"}]}], ";", "\n", "    ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", " ", 
           RowBox[{"DirectoryQ", "[", "pairDirectory", "]"}]}], ",", " ", 
          RowBox[{"fail", "[", 
           
           RowBox[{"\"\<Pair folder not found: \>\"", " ", "<>", " ", 
            "pairDirectory"}], "]"}]}], "]"}], ";", "\n", "    ", 
        RowBox[{"pairFiles", " ", "=", " ", 
         RowBox[{"FileNames", "[", 
          RowBox[{"\"\<F*_C*.wl\>\"", ",", " ", "pairDirectory"}], "]"}]}], ";",
         "\n", "    ", 
        RowBox[{"pairData", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<File\>\"", " ", "->", " ", "#"}], ",", " ", 
             RowBox[{"\"\<Pair\>\"", " ", "->", " ", 
              RowBox[{"parsePairFile", "[", "#", "]"}]}]}], "|>"}], " ", 
           "&"}], " ", "/@", " ", "pairFiles"}]}], ";", "\n", "    ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{
            RowBox[{"Lookup", "[", 
             RowBox[{"pairData", ",", " ", "\"\<Pair\>\""}], "]"}], ",", " ", 
            "$Failed"}], "]"}], ",", " ", 
          RowBox[{"fail", "[", 
           
           RowBox[{"\"\<Invalid pair filename in \>\"", " ", "<>", " ", 
            "pairDirectory"}], "]"}]}], "]"}], ";", "\n", "    ", 
        RowBox[{"pairData", " ", "=", " ", 
         RowBox[{"SortBy", "[", 
          RowBox[{"pairData", ",", " ", 
           RowBox[{
            RowBox[{"#", "[", "\"\<Pair\>\"", "]"}], " ", "&"}]}], "]"}]}], ";",
         "\n", "    ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"!", " ", 
            RowBox[{"DuplicateFreeQ", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"pairData", ",", " ", "\"\<Pair\>\""}], "]"}], "]"}]}], 
           " ", "||", " ", 
           RowBox[{
            RowBox[{"Lookup", "[", 
             RowBox[{"pairData", ",", " ", "\"\<Pair\>\""}], "]"}], " ", "=!=",
             " ", "expectedPairs"}]}], ",", "\n", "      ", 
          RowBox[{
          "fail", "[", "\"\<The result folder does not contain exactly the \
card's expected pairs.\>\"", "]"}]}], "\n", "    ", "]"}], ";", "\n", "    ", 
        
        RowBox[{"results", " ", "=", " ", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"file", ",", " ", 
            RowBox[{"Append", "[", 
             RowBox[{
              RowBox[{"Get", "[", "file", "]"}], ",", " ", 
              
              RowBox[{"\"\<ResultDirectory\>\"", " ", "->", " ", 
               "ResultDirectory"}]}], "]"}]}], "]"}], " ", "/@", " ", 
          RowBox[{"Lookup", "[", 
           RowBox[{"pairData", ",", " ", "\"\<File\>\""}], "]"}]}]}], ";", 
        "\n", "    ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", " ", 
           RowBox[{"AllTrue", "[", 
            RowBox[{"results", ",", " ", "AssociationQ"}], "]"}]}], ",", " ", 
          
          RowBox[{
          "fail", "[", "\"\<A pair result is not an Association.\>\"", 
           "]"}]}], "]"}], ";", "\n", "    ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", " ", 
           RowBox[{"AllTrue", "[", 
            RowBox[{"results", ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Lookup", "[", 
                RowBox[{"#", ",", " ", "\"\<CardName\>\"", ",", " ", "None"}],
                 "]"}], " ", "===", " ", "CardName"}], " ", "&"}]}], "]"}]}], 
          ",", " ", 
          RowBox[{
          "fail", "[", "\"\<A pair result belongs to a different card.\>\"", 
           "]"}]}], "]"}], ";", "\n", "    ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", " ", 
           RowBox[{"And", " ", "@@", " ", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"Lookup", "[", 
                  RowBox[{
                   RowBox[{"#1", "[", "\"\<Pair\>\"", "]"}], ",", " ", 
                   RowBox[{"{", 
                    
                    RowBox[{"\"\<Forward\>\"", ",", 
                    " ", "\"\<Conjugate\>\""}], "}"}]}], "]"}], " ", "===", 
                 " ", "#2"}], " ", "&"}], ")"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"results", ",", " ", 
                RowBox[{"Lookup", "[", 
                 RowBox[{"pairData", ",", " ", "\"\<Pair\>\""}], "]"}]}], 
               "}"}]}], "]"}]}]}], ",", "\n", "      ", 
          RowBox[{
          "fail", "[", "\"\<Stored pair metadata does not match the \
filenames.\>\"", "]"}]}], "\n", "    ", "]"}], ";", "\n", "    ", 
        RowBox[{"Print", " ", "@", " ", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<Card\>\"", ",", " ", "CardName"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<Result folder\>\"", ",", " ", 
               RowBox[{"FileNameTake", "[", "ResultDirectory", "]"}]}], "}"}],
              ",", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<Pair files\>\"", ",", " ", 
               RowBox[{"Length", "[", "results", "]"}]}], "}"}]}], "}"}], ",",
            " ", 
           RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]}], ";", "\n", 
        "    ", "results"}]}], "\n", "  ", "]"}], ",", "\n", 
     "  ", "\"\<LoadResults\>\""}], "\n", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"2b5cac33-c5a4-44de-b5b5-626ac9aa4b6d"],

