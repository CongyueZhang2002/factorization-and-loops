ChartY^6*c[1017]-31296*eps^5*stripChartX^4*stripChartY^6*c[1017]+406*eps*stripChartX*stripChartY^7*c[1017]+4466*eps^2*stripChartX*stripChartY^7*c[1017]+17052*eps^3*stripChartX*stripChartY^7*c[1017]+25984*eps^4*stripChartX*stripChartY^7*c[1017]+12992*eps^5*stripChartX*stripChartY^7*c[1017]-812*eps*stripChartX^2*stripChartY^7*c[1017]-8932*eps^2*stripChartX^2*stripChartY^7*c[1017]-34104*eps^3*stripChartX^2*stripChartY^7*c[1017]-51968*eps^4*stripChartX^2*stripChartY^7*c[1017]-25984*eps^5*stripChartX^2*stripChartY^7*c[1017]+406*eps*stripChartX^3*stripChartY^7*c[1017]+4466*eps^2*stripChartX^3*stripChartY^7*c[1017]+17052*eps^3*stripChartX^3*stripChartY^7*c[1017]+25984*eps^4*stripChartX^3*stripChartY^7*c[1017]+12992*eps^5*stripChartX^3*stripChartY^7*c[1017])/(180*(1+eps)*(1+2*eps)*(1+4*eps)^2*stripChartX*(stripChartX-stripChartY)^2*(-1+stripChartY)*stripChartY^2*(-1+stripChartX+stripChartY)*(-stripChartX-stripChartY+stripChartX*stripChartY)^2)]):
C := vector(17,[c[1001],c[1002],c[1003],c[1004],c[1005],c[1006],c[1007],c[1008],c[1009],c[1010],c[1011],c[1012],c[1013],c[1014],c[1015],c[1016],c[1017]]):
errors := []:
attempts := []:
solved := false:
method := "None":
try
  Vtry := timelimit(120,Mratsolde(A1,stripChartX,b1)):
  if Vtry <> {} then V := Vtry: solved := true: method := "IntegrableConnections" end if:
catch: errors := [op(errors),lastexception]: end try:
if not solved then
  denbase := ((-1+stripChartX)*stripChartX*(stripChartX-stripChartY)*(-1+stripChartX+stripChartY)*(stripChartX+stripChartY)*(-stripChartX-stripChartY+stripChartX*stripChartY)*(-stripChartX-stripChartY+2*stripChartX*stripChartY))/((-1+stripChartY)*(-1+2*stripChartY)):
  for denpower in [1,2,3] while not solved do
    den := denbase^denpower:
    basedegree := degree(den,stripChartX):
    for degreeoffset in [0,1,2] while not solved do
      ansatzdegree := basedegree + degreeoffset:
      Vtry := vector(16,[seq(add(aa[i,k]*stripChartX^k,k=0..ansatzdegree)/den,i=1..16)]):
      residual := map(normal,evalm(map(diff,Vtry,stripChartX)-A1&*Vtry-b1)):
      equations := {}:
      for i from 1 to 16 do
        equations := equations union {coeffs(numer(residual[i]),stripChartX)}:
      end do:
      ansatzcoeffs := {seq(seq(aa[i,k],k=0..ansatzdegree),i=1..16)}:
      unknowns := ansatzcoeffs union {c[1001],c[1002],c[1003],c[1004],c[1005],c[1006],c[1007],c[1008],c[1009],c[1010],c[1011],c[1012],c[1013],c[1014],c[1015],c[1016],c[1017]}:
      try
        ansatzsolution := timelimit(120,solve(equations,unknowns)):
        attempts := [op(attempts),[1,denpower,degreeoffset,nops(equations),nops(unknowns),type(ansatzsolution,set)]]:
        if type(ansatzsolution,set) then
          Vraw := map(normal,eval(Vtry,ansatzsolution)):
          Craw := map(normal,eval(C,ansatzsolution)):
          freeaa := indets([op(convert(Vraw,list)),op(convert(Craw,list))]) intersect ansatzcoeffs:
          freeaarules := {seq(q=0,q in freeaa)}:
          Vcandidate := map(normal,eval(Vraw,freeaarules)):
          Ccandidate := map(normal,eval(Craw,freeaarules)):
          Crules := {seq(C[i]=Ccandidate[i],i=1..17)}:
          bcandidate := map(normal,eval(b1,Crules)):
          candidatecheck := map(normal,evalm(map(diff,Vcandidate,stripChartX)-A1&*Vcandidate-bcandidate)):
          if convert(candidatecheck,set) = {0} then
            V := Vcandidate: C := Ccandidate: solved := true:
            method := cat("ExactLetterAnsatz:",denpower,":",degreeoffset):
          end if:
        end if:
      catch: errors := [op(errors),lastexception]: end try:
    end do:
  end do:
end if:
fd := fopen("/home/maxzhang/factorization-and-loops/External/CodexExchange/triple_root_2026-08-22/cf300_first_strip_probe/sector_CF300_codex_triple_root/CF300_8_6_first_1.out", WRITE):
if solved then fprintf(fd, "OK\n%a\n%a\n%s\n",convert(V,list),convert(C,list),method) else fprintf(fd, "FAIL\n%a\n%a\n",errors,attempts) end if:
fclose(fd):
quit:
