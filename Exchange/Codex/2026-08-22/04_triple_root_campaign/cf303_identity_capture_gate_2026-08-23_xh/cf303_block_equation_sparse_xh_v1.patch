+(* Exact sparse block product.  Literal zeros are the only terms omitted;
+   every retained product has the same order and scalar factors as Dot.
+   Deliberately do not Together here: blockEquation owns the single final
+   normalization of each forcing entry. *)
+ClearAll[blockEquationSparseDot];
+blockEquationSparseDot[left_List, right_List] := Module[
+  {leftSupport, rightSupport, common},
+  If[! MatrixQ[left] || ! MatrixQ[right] ||
+      left === {} || right === {} ||
+      Length[First[left]] =!= Length[right], Return[$Failed]];
+  leftSupport =
+    Flatten[Position[#, Except[0], {1}, Heads -> False]] & /@ left;
+  rightSupport =
+    Flatten[Position[#, Except[0], {1}, Heads -> False]] & /@
+      Transpose[right];
+  Table[
+    common = Intersection[leftSupport[[i]], rightSupport[[j]]];
+    Which[
+      common === {}, 0,
+      Length[common] === 1,
+        left[[i, First[common]]] right[[First[common], j]],
+      True, Total[(left[[i, #]] right[[#, j]]) & /@ common]],
+    {i, Length[left]}, {j, Length[First[right]]}]
+];
