  fprintf(fd, "rationalsolutions_result_type=%a\n", whattype(rationalBasis)):
  if rationalBasis = {} then
    fprintf(fd, "rationalsolutions_empty=true\n"):
  else
    rationalBasis := convert(rationalBasis,matrix):
    fprintf(fd, "rationalsolutions_empty=false\n"):
    fprintf(fd, "basis_rows=%d\n", rowdim(rationalBasis)):
    fprintf(fd, "basis_columns=%d\n", coldim(rationalBasis)):
    residual1 := map(normal,evalm(map(diff,rationalBasis,variables[1])-A1&*rationalBasis)):
    residual2 := map(normal,evalm(map(diff,rationalBasis,variables[2])-A2&*rationalBasis)):
    fprintf(fd, "basis_residual_1_zero=%a\n", evalb(convert(residual1,set)={0})):
    fprintf(fd, "basis_residual_2_zero=%a\n", evalb(convert(residual2,set)={0})):
    rf := fopen("/home/maxzhang/factorization-and-loops/Codex/TwoRootMapleAugmented/05_cf254_augmented_yx.result.txt", WRITE):
    fprintf(rf, "%a\n", convert(rationalBasis,listlist)):
