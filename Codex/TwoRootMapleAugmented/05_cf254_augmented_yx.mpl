solveStart := time[real]():
try
  rationalBasis := RationalSolutions(connection,variables,['param',[eps]]):
  solveSeconds := time[real]() - solveStart:
  fd := fopen("/home/maxzhang/factorization-and-loops/Codex/TwoRootMapleAugmented/05_cf254_augmented_yx.ledger.log", APPEND):
  fprintf(fd, "rationalsolutions_status=RETURNED\n"):
